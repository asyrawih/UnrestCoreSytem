#!/usr/bin/env bash
#
# Stamp the UnrestCoreSystem banner on every file this commit ADDS.
#
# Only added files (--diff-filter=A) are touched, so editing an existing file never
# re-writes its header, and a file whose banner you deliberately deleted stays deleted.
#
# Install with: .githooks/install.sh   (sets core.hooksPath to this directory)
# Bypass once with: git commit --no-verify

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APPLY="$HOOK_DIR/apply-banner.sh"

[ -x "$APPLY" ] || exit 0

added=()
while IFS= read -r -d '' path; do
	added+=("$path")
done < <(git diff --cached --name-only --diff-filter=A -z)

[ "${#added[@]}" -gt 0 ] || exit 0

output="$("$APPLY" "${added[@]}")"
echo "$output"

# Re-stage whatever the stamp rewrote, so the banner lands in this commit and not the next.
stamped=()
while IFS= read -r line; do
	case "$line" in
		"banner: stamped "*) stamped+=("${line#banner: stamped }") ;;
	esac
done <<< "$output"

if [ "${#stamped[@]}" -gt 0 ]; then
	git add -- "${stamped[@]}"
fi
