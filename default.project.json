{
  "name": "UnrestCoreSystem",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "Unrest": {
        "$path": "src/shared"
      },

      "Game": {
        "$path": "src/game"
      },

      "GameTransport": {
        "$path": {
          "optional": "src/game-transport"
        }
      },

      "Packages": {
        "$path": {
          "optional": "Packages"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",

      "Game": {
        "$path": "src/game-server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",

        "Game": {
          "$path": "src/game-client"
        }
      }
    }
  }
}
