--!strict
--[[
    Game / Packets

    THIS GAME'S WIRE FORMAT. The framework never reads this file, never requires it, and has
    no idea it exists. It is the half of "the framework only bridges; the user defines the
    packets" that belongs to the user.

    Three packets and nothing else, because Stage 1 of the migration is a GENERIC ENVELOPE:

        Request   client -> server   { Id, Command, Payload }
        Response  server -> client   { Id, Ok, Reason, Value }
        Publish   server -> client   { Channel, Value }

    A generic envelope costs zero work per command -- declaring a new command in
    `Contracts.luau` puts it on the wire with no packet to write and no `Wire` field to keep in
    step. Typed packets per command are the optimisation that comes after, one command at a
    time, and the framework cannot tell the difference: to it both are just a transport.

    --------------------------------------------------------------------------------
    WHY THE PAYLOAD IS A `buff` AND NOT `ByteNet.unknown`
    --------------------------------------------------------------------------------

    `ByteNet.unknown` is the obvious way to put "any plain value" in an envelope: it writes one
    index byte and hands the value itself to Roblox's own remote serialiser, riding alongside
    the buffer. It was the plan. Four things killed it, and only the first is cosmetic:

      1. `bufferWriter.reference` in bytenet-max 1.0.0 contains a leftover `print(references)`
         (`process/bufferWriter.luau:75`). Every `unknown` write prints the whole reference
         table to the output window -- one print per request, forever. It cannot be patched
         from here: `dataTypes/unknown.luau` captures `bufferWriter.reference` into a local at
         require time, so replacing the field on the module table afterwards changes nothing,
         and `Packages/` is generated by Wally and must not be edited.
      2. The reference index is a `u8`, so at most 255 values ride along per batched buffer.
         A busy frame silently overflows it.
      3. `unknown` compresses nothing. Choosing ByteNet and then sending every payload as an
         ordinary remote argument gives up the entire reason for choosing it.
      4. Anything at all can be put in that reference table by a client, Instances included.
         The framework's validator refuses Instances, so this is not a hole -- but a codec
         that cannot REPRESENT an Instance is a better place to stand than a codec that can
         and relies on a later check.

    So the payload is serialised here, by us, into a plain `buffer`, and travels as
    `ByteNet.buff`. The tag set is exactly the framework's `ArgumentKind` whitelist:

        nil  boolean  number  string  table  Vector3  Color3  EnumItem

    and the depth, entry-count and string-length ceilings are read from
    `Constants.Limits`, THE SAME NUMBERS the server gateway enforces. That equality matters:
    it means this codec can never refuse something the gateway would have accepted, so
    encoding is not a second, quieter policy.

    --------------------------------------------------------------------------------
    WHY THIS FILE REACHES INSIDE `Packages/_Index`
    --------------------------------------------------------------------------------

    Because bytenet-max 1.0.0 does not load. `namespaces/namespace.luau:12` and
    `dataTypes/struct.luau:3` both require `namespaces.namespacesDependencies`, and the file
    is called `namespaceDependencies.luau` -- one letter. `src/init.luau` requires both, so
    `require(ReplicatedStorage.Packages.ByteNet)` raises "Requested module experienced an
    error while loading" and there is no version of this file that can use the documented API.

    Nothing user-side can repair that: a runtime `ModuleScript` cannot be given a `Source`, and
    `Packages/` is Wally's to overwrite. What IS available is every module the broken pair does
    not touch -- the data types, the buffer writer, `definePacket`, `packetIDs`, and both
    process halves -- so this file assembles them directly and does the one job the namespace
    would have done: hand each packet a stable id.

    Doing it by hand is not purely a workaround, either. `defineNamespace` assigns ids on the
    server and replicates them through a `StringValue`, which the client reads with
    `FindFirstChild` and no wait -- so a client that requires a namespace before that value has
    replicated gets nil and throws. Fixed ids agreed by both realms have no such race.

    WHEN UPSTREAM FIXES THE TYPO, this file should shrink to `require(Packages.ByteNet)` plus
    `defineNamespace`, and `PACKAGE` below is the only place that needs to know. The pinned
    version string is deliberate: bumping ByteNet breaks this loudly rather than quietly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Unrest.Constants)

--- The package's own module tree. See the header for why `Packages.ByteNet` is not required.
local PACKAGE = ReplicatedStorage.Packages._Index["elitriare_bytenet-max@1.0.0"]["bytenet-max"]

local boolType = require(PACKAGE.dataTypes.bool)
local buffType = require(PACKAGE.dataTypes.buff)
local clientProcess = require(PACKAGE.process.client)
local definePacket = require(PACKAGE.packets.definePacket)
local packetIDs = require(PACKAGE.namespaces.packetIDs)
local serverProcess = require(PACKAGE.process.server)
local stringType = require(PACKAGE.dataTypes.string)
local uint32Type = require(PACKAGE.dataTypes.uint32)

local Limits = Constants.Limits

--------------------------------------------------------------------------------
-- Types
--------------------------------------------------------------------------------

--- What a ByteNet packet offers. `send` exists only on the client and `sendTo`/`sendToAll`
--- only on the server; the package's own run-context guard is broken (its `__index` handler
--- takes the table as its first argument and compares it against method names, so it never
--- fires), which is why every call site here branches on the realm itself.
export type Packet<T> = {
    send: (data: T) -> (),
    sendTo: (data: T, player: Player) -> (),
    sendToAll: (data: T) -> (),
    listen: (callback: (data: any, player: Player?) -> ()) -> (),
}

--[[
    `Id` is the correlation id, and zero means "fire and forget". ByteNet is one-way by
    design, so request/response is two packets plus this number; the server echoes it back on
    the `Response` packet and the client matches it to the thread that is waiting.

    `Command` is a plain ByteNet string and is NOT trusted here. It is handed to the gateway
    exactly as it arrived, which is the whole point: the transport carries names, the gateway
    decides what they mean.
]]
export type RequestEnvelope = {
    Id: number,
    Command: string,
    Payload: buffer,
}

--- `Reason` is the framework's `RejectionReason` as a string, or "" for none. A string rather
--- than a byte enum on purpose: the framework may add a reason, and a table of codes here
--- would then be a second definition of a list that already exists in `Net/Types`.
export type ResponseEnvelope = {
    Id: number,
    Ok: boolean,
    Reason: string,
    Value: buffer,
}

export type PublishEnvelope = {
    Channel: string,
    Value: buffer,
}

--------------------------------------------------------------------------------
-- The payload codec
--------------------------------------------------------------------------------

local TAG_NIL = 0
local TAG_FALSE = 1
local TAG_TRUE = 2
local TAG_NUMBER = 3
local TAG_STRING = 4
local TAG_TABLE = 5
local TAG_VECTOR3 = 6
local TAG_COLOR3 = 7
local TAG_ENUMITEM = 8

--- `ByteNet.buff` writes its length as a `u16`, so a payload larger than this cannot be
--- framed at all. Refusing at encode time is the difference between a clear local error and a
--- truncated length field producing garbage on the far side.
local MAX_BLOB = 65535

--- `Enum.KeyCode` stringifies as "Enum.KeyCode"; only the tail is worth sending.
local ENUM_PREFIX = "Enum."

local Codec = {}

local encodeValue: (value: any, depth: number, seen: { [any]: boolean }, out: { string }) -> ()

local function isFinite(value: number): boolean
    return value == value and value ~= math.huge and value ~= -math.huge
end

--[[
    Encodes a table. The count goes in front of the entries, so the entries are built into
    their own list first and moved across once the count is known -- the alternative is
    seeking backwards in a buffer, which `bufferWriter` cannot do.

    Depth and entry ceilings are `Constants.Limits`, exactly as `Validate.checkTable` applies
    them, so anything the gateway would accept survives this walk.
]]
local function encodeTable(value: any, depth: number, seen: { [any]: boolean }, out: { string }): ()
    if depth > Limits.MaxPayloadDepth then
        error(`a table nested deeper than {Limits.MaxPayloadDepth} levels`, 0)
    end
    if seen[value] then
        error("a cyclic table", 0)
    end
    if getmetatable(value :: any) ~= nil then
        error("a table with a metatable", 0)
    end

    seen[value] = true

    local entries: { string } = {}
    local count = 0

    for key, entry in value :: { [any]: any } do
        count += 1
        if count > Limits.MaxPayloadEntries then
            error(`a table with more than {Limits.MaxPayloadEntries} entries`, 0)
        end

        local keyKind = typeof(key)
        if keyKind ~= "string" and keyKind ~= "number" then
            error(`a table with a {keyKind} key`, 0)
        end

        encodeValue(key, depth + 1, seen, entries)
        encodeValue(entry, depth + 1, seen, entries)
    end

    seen[value] = nil

    table.insert(out, string.pack("<BI2", TAG_TABLE, count))
    table.move(entries, 1, #entries, #out + 1, out)
end

--- Raises on anything this wire will not carry. Every raise is caught by `Codec.Encode`, so
--- the caller gets a reason rather than a traceback.
function encodeValue(value: any, depth: number, seen: { [any]: boolean }, out: { string }): ()
    local kind = typeof(value)

    if value == nil then
        table.insert(out, string.pack("<B", TAG_NIL))
    elseif kind == "boolean" then
        table.insert(out, string.pack("<B", if value then TAG_TRUE else TAG_FALSE))
    elseif kind == "number" then
        if not isFinite(value :: number) then
            error("a non-finite number", 0)
        end
        table.insert(out, string.pack("<Bd", TAG_NUMBER, value :: number))
    elseif kind == "string" then
        local text = value :: string
        if #text > Limits.MaxStringLength then
            error(`a string longer than {Limits.MaxStringLength} characters`, 0)
        end
        table.insert(out, string.pack("<Bs2", TAG_STRING, text))
    elseif kind == "Vector3" then
        local vector = value :: Vector3
        if not isFinite(vector.X) or not isFinite(vector.Y) or not isFinite(vector.Z) then
            error("a Vector3 with a non-finite component", 0)
        end
        table.insert(out, string.pack("<Bfff", TAG_VECTOR3, vector.X, vector.Y, vector.Z))
    elseif kind == "Color3" then
        local color = value :: Color3
        table.insert(out, string.pack("<Bfff", TAG_COLOR3, color.R, color.G, color.B))
    elseif kind == "EnumItem" then
        local item = value :: EnumItem
        local enumName = string.gsub(tostring(item.EnumType), "^" .. ENUM_PREFIX, "")
        table.insert(out, string.pack("<Bs2s2", TAG_ENUMITEM, enumName, item.Name))
    elseif kind == "table" then
        encodeTable(value, depth, seen, out)
    else
        --[[
            Instance, function, thread, userdata. The framework refuses all of them on
            arrival; refusing them here as well means one can never even be put on this wire,
            which is a smaller thing to reason about than a live reference that is checked
            later.
        ]]
        error(`a {kind}, which this wire never carries`, 0)
    end
end

local decodeValue: (text: string, offset: number, depth: number) -> (any, number)

--- Reads a table. `count` is bounded by the same ceiling the encoder applies, so a hostile
--- buffer cannot ask this side to build a million-entry table before anything checks it.
local function decodeTable(text: string, offset: number, depth: number): (any, number)
    if depth > Limits.MaxPayloadDepth then
        error(`a table nested deeper than {Limits.MaxPayloadDepth} levels`, 0)
    end

    local count: number
    count, offset = string.unpack("<I2", text, offset)

    if count > Limits.MaxPayloadEntries then
        error(`a table claiming more than {Limits.MaxPayloadEntries} entries`, 0)
    end

    local result: { [any]: any } = {}
    for _ = 1, count do
        local key: any
        local entry: any
        key, offset = decodeValue(text, offset, depth + 1)
        entry, offset = decodeValue(text, offset, depth + 1)

        local keyKind = typeof(key)
        if keyKind ~= "string" and keyKind ~= "number" then
            error(`a table with a {keyKind} key`, 0)
        end
        result[key] = entry
    end

    return result, offset
end

--- Raises on a malformed buffer. `string.unpack` raises by itself when the data runs out, so
--- truncation needs no explicit check.
function decodeValue(text: string, offset: number, depth: number): (any, number)
    local tag: number
    tag, offset = string.unpack("<B", text, offset)

    if tag == TAG_NIL then
        return nil, offset
    elseif tag == TAG_FALSE then
        return false, offset
    elseif tag == TAG_TRUE then
        return true, offset
    elseif tag == TAG_NUMBER then
        local number: number
        number, offset = string.unpack("<d", text, offset)
        return number, offset
    elseif tag == TAG_STRING then
        local value: string
        value, offset = string.unpack("<s2", text, offset)
        if #value > Limits.MaxStringLength then
            error(`a string longer than {Limits.MaxStringLength} characters`, 0)
        end
        return value, offset
    elseif tag == TAG_TABLE then
        return decodeTable(text, offset, depth)
    elseif tag == TAG_VECTOR3 then
        local x: number, y: number, z: number
        x, y, z, offset = string.unpack("<fff", text, offset)
        return Vector3.new(x, y, z), offset
    elseif tag == TAG_COLOR3 then
        local r: number, g: number, b: number
        r, g, b, offset = string.unpack("<fff", text, offset)
        return Color3.new(r, g, b), offset
    elseif tag == TAG_ENUMITEM then
        local enumName: string, itemName: string
        enumName, itemName, offset = string.unpack("<s2s2", text, offset)
        -- Both indexes raise on an unknown name, which is the refusal we want.
        return (Enum :: any)[enumName][itemName], offset
    end

    error(`an unknown value tag ({tag})`, 0)
end

--[[
    Serialises a payload. Returns nil plus a reason rather than raising, because both callers
    -- a client about to send and a server about to publish -- have somewhere better to put a
    failure than a traceback.

    Refusing here is the transport DROPPING something it cannot carry, never the transport
    deciding what a message means. Every value this refuses is a value `Validate` would refuse
    too, because both read `Constants.Limits`.
]]
--- `encodeValue` returns nothing, and `pcall` of a function returning nothing yields only the
--- success flag. This wrapper exists so the raised message survives the call.
local function encodeRoot(value: any, out: { string }): any
    encodeValue(value, 1, {}, out)
    return nil
end

function Codec.Encode(value: any): (buffer?, string?)
    local out: { string } = {}

    local ok, err = pcall(encodeRoot, value, out)
    if not ok then
        return nil, tostring(err)
    end

    local text = table.concat(out)
    if #text > MAX_BLOB then
        return nil, `{#text} bytes, over the {MAX_BLOB}-byte ceiling a ByteNet buff can frame`
    end

    return buffer.fromstring(text), nil
end

--- Deserialises a payload. Never raises; a buffer that will not read is a refusal, reported
--- by the caller so it still reaches the abuse counter.
function Codec.Decode(blob: buffer): (boolean, any, string?)
    local text = buffer.tostring(blob)

    local ok, value, offset = pcall(decodeValue, text, 1, 1)
    if not ok then
        return false, nil, tostring(value)
    end
    if offset ~= #text + 1 then
        -- Trailing bytes mean the sender and this codec disagree about the format. That is
        -- not a payload; it is a different protocol wearing one.
        return false, nil, `{#text + 1 - offset} trailing byte(s)`
    end

    return true, value, nil
end

--- Pre-encoded `nil`, for the response to a request that produced no value. Encoding nil
--- cannot fail, so this is a constant rather than a call that has to be checked.
local NIL_BLOB = Codec.Encode(nil) :: buffer

--------------------------------------------------------------------------------
-- The packets
--------------------------------------------------------------------------------

local ByteBool = boolType()
local ByteBuffer = buffType()
local ByteString = stringType()
local ByteU32 = uint32Type()

--[[
    Returned in place of an envelope that would not deserialise.

    ByteNet's reader loop has no error handling: a raise inside a packet's `read` escapes
    through the RemoteEvent callback, and every later packet in that batch is lost with no
    report. So each reader below runs under `pcall` and, on failure, returns this sentinel
    while claiming the rest of the buffer -- the loop ends cleanly, the listener sees a
    malformed request, and `OnRefusal` reaches the abuse counter with the player attached.
]]
local Malformed: any = table.freeze({})

--- Ids are written as one byte in front of every packet and must agree across realms. Fixed
--- here because nothing else allocates any: `defineNamespace`, the only other allocator, does
--- not load. 1..3 are reserved by this game.
local REQUEST_ID = 1
local RESPONSE_ID = 2
local PUBLISH_ID = 3

--- Wraps a reader so a malformed buffer becomes a value instead of a raise. The claimed
--- length is the whole remainder: nothing after a broken envelope can be trusted to start on
--- a packet boundary.
local function guarded<T>(read: (b: buffer, cursor: number) -> (T, number)): (buffer, number) -> (any, number)
    return function(b: buffer, cursor: number): (any, number)
        local ok, value, length = pcall(read, b, cursor)
        if ok then
            return value, length
        end
        return Malformed, buffer.len(b) - cursor
    end
end

local function readRequest(b: buffer, cursor: number): (RequestEnvelope, number)
    local id, idLength = ByteU32.read(b, cursor)
    local command, commandLength = ByteString.read(b, cursor + idLength)
    local payload, payloadLength = ByteBuffer.read(b, cursor + idLength + commandLength)

    return { Id = id, Command = command, Payload = payload }, idLength + commandLength + payloadLength
end

local function readResponse(b: buffer, cursor: number): (ResponseEnvelope, number)
    local id, idLength = ByteU32.read(b, cursor)
    local ok, okLength = ByteBool.read(b, cursor + idLength)
    local reason, reasonLength = ByteString.read(b, cursor + idLength + okLength)
    local value, valueLength = ByteBuffer.read(b, cursor + idLength + okLength + reasonLength)

    return { Id = id, Ok = ok, Reason = reason, Value = value }, idLength + okLength + reasonLength + valueLength
end

local function readPublish(b: buffer, cursor: number): (PublishEnvelope, number)
    local channel, channelLength = ByteString.read(b, cursor)
    local value, valueLength = ByteBuffer.read(b, cursor + channelLength)

    return { Channel = channel, Value = value }, channelLength + valueLength
end

--[[
    Builds one packet at a fixed id and registers it with the reader.

    `definePacket` hands back a factory that wants an id -- normally supplied by a namespace,
    supplied here instead. `packetIDs.set` is the other half of what a namespace does: without
    it an arriving buffer names an id nothing answers to, and ByteNet raises.
]]
local function register<T>(id: number, value: { read: (buffer, number) -> (any, number), write: (T) -> () }): Packet<T>
    local built = (definePacket :: any)({ value = value, reliabilityType = "reliable" })(id)
    packetIDs.set(id, built)
    return (built :: any) :: Packet<T>
end

local Request: Packet<RequestEnvelope> = register(REQUEST_ID, {
    read = guarded(readRequest),
    write = function(envelope: RequestEnvelope): ()
        ByteU32.write(envelope.Id)
        ByteString.write(envelope.Command)
        ByteBuffer.write(envelope.Payload)
    end,
})

local Response: Packet<ResponseEnvelope> = register(RESPONSE_ID, {
    read = guarded(readResponse),
    write = function(envelope: ResponseEnvelope): ()
        ByteU32.write(envelope.Id)
        ByteBool.write(envelope.Ok)
        ByteString.write(envelope.Reason)
        ByteBuffer.write(envelope.Value)
    end,
})

local Publish: Packet<PublishEnvelope> = register(PUBLISH_ID, {
    read = guarded(readPublish),
    write = function(envelope: PublishEnvelope): ()
        ByteString.write(envelope.Channel)
        ByteBuffer.write(envelope.Value)
    end,
})

--------------------------------------------------------------------------------

local started = false

--[[
    Brings up ByteNet's process for this realm: the server creates the two RemoteEvents and
    the flush loop, the client waits for them and connects to them.

    YIELDS ON THE CLIENT (`WaitForChild`), so callers spawn it. Sends made before it returns
    are not lost -- ByteNet buffers into a module-level channel from the moment this file is
    required, and the first Heartbeat after the wait flushes everything that accumulated.

    Idempotent, and one-way: ByteNet offers no way to shut a process down again, which is why
    `Transport.Destroy` is a flag rather than an unbind.
]]
local function start(): ()
    if started then
        return
    end
    started = true

    if RunService:IsServer() then
        serverProcess.start()
    else
        clientProcess.start()
    end
end

return table.freeze({
    Codec = Codec,
    --- A pre-encoded `nil` payload, for a response that carries no value.
    NilBlob = NIL_BLOB,
    --- Compare an incoming envelope against this before reading it.
    Malformed = Malformed,

    Request = Request,
    Response = Response,
    Publish = Publish,

    Start = start,
})
