# Rojo sourcemap — regenerated on demand (luau-lsp.nvim rewrites it constantly).
# The plugin has its own project and so its own sourcemap, and it must sit inside `plugin/`:
# rojo writes its paths relative to the project file and luau-lsp resolves them against the
# working directory, so both stand there.
sourcemap.json
plugin/plugin-sourcemap.json

# Wally-installed dependency trees. wally.lock IS tracked (see below) so these
# are fully reproducible from `wally install`.
/Packages
/DevPackages
/ServerPackages

# Do NOT ignore wally.lock — it pins the resolved dependency graph.
!wally.lock

# Roblox place / model artifacts
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
*.rbxm
*.rbxmx
.claude

# Misc
.DS_Store

# Documentation site (Moonwave -> Docusaurus). See moonwave.toml and package.json.
# Moonwave keeps its scratch Docusaurus project in the OS cache dir
# (~/Library/Caches/moonwave/ on macOS), so the only things it puts in this repo
# are the two below.
node_modules/
/build
graphify-out
bench
